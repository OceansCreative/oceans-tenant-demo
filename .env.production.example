# OceansTenant 本番環境変数テンプレート（Vercel Production 用）
#
# このファイルは Vercel ダッシュボード（Settings → Environment Variables）に
# コピペで投入することを想定した雛形である。`.env.example` よりも踏み込んで
# 「本番デモで安全に動かす推奨値」を明文化している。
#
# 公開対象: https://demo.oceans-base.com/tenant-search
#
# ⚠ 実際のキー・トークンは絶対にコミットしないこと。本ファイルはプレースホルダのみ。
# ⚠ `NEXT_PUBLIC_*` 接頭辞の env はビルド時に client bundle へ inline される。
#    機密情報には絶対に `NEXT_PUBLIC_` を付けない。詳細は docs/PRODUCTION_SAFETY.md 参照。

# ──────────────────────────────────────────────
# Sanity（コンテンツ管理 / 物件データ）
# ──────────────────────────────────────────────

# 必須: Sanity プロジェクト ID（クライアントも参照するため公開可）
NEXT_PUBLIC_SANITY_PROJECT_ID=

# 必須: 本番データセット（通常は `production`）
NEXT_PUBLIC_SANITY_DATASET=production

# 必須: Sanity 読み取り専用トークン（getSanityClient が参照）
# 権限: Viewer のみ（Editor 以上を渡さない）
# 取得方法: https://www.sanity.io/manage → API → Tokens（Viewer）
SANITY_API_READ_TOKEN=

# 任意: Sanity 書き込みトークン
# admin / ingest 経由で Sanity に書き込む構成を有効化する場合のみ設定する。
# 公開デモでは未設定推奨（書き込みを物理的に不可能にする）。
# 権限: Editor（最小権限）
# SANITY_API_TOKEN=

# ──────────────────────────────────────────────
# Anthropic Claude API（AI 連携 / 対話検索・URL 抽出）
# ──────────────────────────────────────────────

# 必須: Anthropic API キー（サーバ側のみ、絶対に NEXT_PUBLIC_ を付けない）
# コスト管理: console.anthropic.com で月次予算アラートを必ず設定する。
# 詳細は docs/PRODUCTION_SAFETY.md「コスト管理」セクション参照。
ANTHROPIC_API_KEY=

# 推奨: 使用する Claude モデル
ANTHROPIC_MODEL=claude-sonnet-4-5

# ──────────────────────────────────────────────
# アプリケーション全般
# ──────────────────────────────────────────────

# 必須: 公開 URL（OG / canonical / metadataBase に使用）
NEXT_PUBLIC_APP_URL=https://demo.oceans-base.com/tenant-search

# 必須（`/tenant-search` サブパスで公開する場合）: basePath / assetPrefix の切替
OCEANS_BASEPATH=/tenant-search

# ──────────────────────────────────────────────
# Feature flags（本番デフォルト: 公開デモなので admin は無効）
# ──────────────────────────────────────────────

# 本番デモでは false 推奨。`/admin` 配下を一切公開せず middleware で 404 にする。
# 編集が必要な場合でも、まず SANITY_API_TOKEN を未設定にして read-only 構成のまま
# 有効化することを検討する。詳細は docs/PRODUCTION_SAFETY.md 参照。
NEXT_PUBLIC_ADMIN_ENABLED=false

# ──────────────────────────────────────────────
# レート制限（デフォルト値で OK / 必要時のみ上書き）
# ──────────────────────────────────────────────

# /api/chat-search のトークンバケット（capacity / refill 間隔 ms）
# RATE_LIMIT_CHAT_CAPACITY=20
# RATE_LIMIT_CHAT_REFILL_INTERVAL_MS=6000

# /api/ingest-url のトークンバケット
# RATE_LIMIT_INGEST_CAPACITY=10
# RATE_LIMIT_INGEST_REFILL_INTERVAL_MS=12000

# ──────────────────────────────────────────────
# オプション機能
# ──────────────────────────────────────────────

# 地図ビュー有効化（未設定時はリスト表示のみで動作）
# HTTP リファラ制限を必ず Google Cloud Console 側で設定する。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
