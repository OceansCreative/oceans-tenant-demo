{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @oceans-tenant/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "regions": ["hnd1"],
  "functions": {
    "apps/web/src/app/api/**/route.ts": {
      "maxDuration": 60
    }
  }
}
