# OceansTenant 環境変数テンプレート
#
# コピー方法:
#   cp .env.example .env.local
#
# ⚠ 実際のキー・トークンは絶対にコミットしないこと。
#   このファイルは「プレースホルダのみ」を含む雛形である。
#
# Vercel 環境では本ファイルではなく Vercel ダッシュボードの
# Environment Variables から設定する。詳細は docs/DEPLOYMENT.md を参照。

# ──────────────────────────────────────────────
# Sanity（コンテンツ管理 / 物件データ）
# ──────────────────────────────────────────────

# 必須: Sanity プロジェクト ID（クライアント側でも参照されるため公開可）
# 取得方法: https://www.sanity.io/manage → 対象プロジェクト → API → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# 必須: Sanity データセット名（通常は `production`）
# 取得方法: https://www.sanity.io/manage → 対象プロジェクト → Datasets
NEXT_PUBLIC_SANITY_DATASET=production

# オプション: Sanity API トークン（サーバ側のみ。書き込みや
# 下書きプレビュー用途。読み取り公開データセットのみであれば未設定でも可）
# 取得方法: https://www.sanity.io/manage → 対象プロジェクト → API → Tokens
# 権限: 用途に応じて Viewer / Editor を選択（最小権限を厳守）
SANITY_API_TOKEN=your-sanity-api-token

# ──────────────────────────────────────────────
# Anthropic Claude API（AI 連携 / 対話検索・URL 抽出）
# ──────────────────────────────────────────────

# 必須: Anthropic API キー（サーバ側のみ。クライアントには絶対公開しない）
# 取得方法: https://console.anthropic.com/ → Settings → API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# オプション: 使用する Claude モデル。未設定時は `claude-sonnet-4-5` を採用
# 一覧: https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# ──────────────────────────────────────────────
# Google Maps（地図ビュー / 任意機能）
# ──────────────────────────────────────────────

# オプション: Google Maps JavaScript API キー
# 未設定時は地図コンポーネントが無効化され、リスト表示のみとなる
# 取得方法: https://console.cloud.google.com/google/maps-apis
# 制限: HTTP リファラ制限を必ず設定する
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ──────────────────────────────────────────────
# アプリケーション全般
# ──────────────────────────────────────────────

# 必須（本番のみ）: 公開 URL。OG / canonical / metadataBase に使用
# 例: https://demo.oceans-base.com/tenant-search
# ローカルでは未設定で OK（http://localhost:3000 が既定値）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# オプション: `/tenant-search` 配下にホストする場合のみ `/tenant-search` を指定
# Vercel の Production / Preview 環境変数で設定する想定
# OCEANS_BASEPATH=/tenant-search

# ──────────────────────────────────────────────
# テスト / 開発（Vercel 本番では不要）
# ──────────────────────────────────────────────

# オプション: Playwright E2E のポート / ベース URL を上書き
# PLAYWRIGHT_PORT=3000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
